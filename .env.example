# ============================================================
# TEMPLATE DE CONFIGURAÇÃO — copie para .env e preencha
# Este arquivo é SEGURO para subir ao GitHub
# ============================================================

# Google Cloud Platform
GCP_PROJECT_ID=

# Google Earth Engine (opcional — service account)
EE_SERVICE_ACCOUNT=
EE_KEY_FILE=

# Configurações de coleta de imagens
DATE_START=2023-01-01
DATE_END=2024-12-31
MAX_CLOUD_PCT=10

# Região padrão de interesse (Amazônia)
LAT_MIN=-7.50
LAT_MAX=-7.00
LON_MIN=-60.50
LON_MAX=-60.00

# API — configurações do servidor
API_HOST=0.0.0.0
API_PORT=8000
